# DEICIDE Environment Configuration Template
# Copy this file to .env and fill in your API key.

# Provider
DEICIDE_PROVIDER=nvidia
DEICIDE_MODEL=z-ai/glm-5.3-flash

# NVIDIA
NVIDIA_API_KEY=SUA_CHAVE_NVIDIA
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Alternative generic DEICIDE API key variable
DEICIDE_API_KEY=

# Execution Budget
DEICIDE_MAX_REQUESTS=3
DEICIDE_MAX_TOKENS=8000

# Quota Management
DEICIDE_QUOTA_ENABLED=true
DEICIDE_QUOTA_SCOPE=nvidia-glm

# Configure these only after confirming your provider's actual limits.
# DEICIDE_RATE_LIMIT_RPM=
# DEICIDE_RATE_LIMIT_TPM=
# DEICIDE_RATE_LIMIT_RPD=

# Security
DEICIDE_ALLOW_EXTERNAL_CODE=0

# Network
DEICIDE_TIMEOUT_SECONDS=120
DEICIDE_MAX_RETRIES=0
